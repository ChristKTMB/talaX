<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta http-equiv="Content-Security-Policy" content="{{ csp | safe }}">
<title>{{ t("ui.report.title") }} — {{ data.file.name or data.file.sha256[:12] }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<main>
  <h1>{{ t("ui.report.title") }}</h1>
  <p class="meta">{% if data.file.name %}{{ data.file.name }} · {% endif %}{{ analysed_at }}</p>

  <p class="verdict">{{ t("ui.report.labelled", label=t("ui.integrity")) }} <strong>{{ data.integrity.label }}</strong></p>
  <p>{{ data.integrity.explanation }}</p>
  <p class="muted">{{ data.disclaimer }}</p>

  <h2>{{ t("ui.report.signals") }}</h2>
  {% for r in results %}
  <div class="check">
    <h3>{{ t("ui.report.labelled", label=r.name) }} <span class="state {{ r.state }}">{{ r.label }}</span></h3>
    <p>{{ r.explanation }}</p>
    {% if r.signal == "weather" and r.evidence.source %}
    <p class="muted">{{ t("ui.report.weather_credit") }} <a href="{{ weather_url }}" rel="noopener noreferrer" target="_blank">Open-Meteo.com</a> (CC BY 4.0) <span class="print-only">{{ weather_url }}</span></p>
    {% endif %}
    {% if r.evidence %}
    <details><summary>{{ t("ui.report.raw_values") }}</summary>
      <pre>{% for k, v in r.evidence.items() %}{{ k }}: {{ v }}
{% endfor %}</pre>
    </details>
    <div class="raw print-only">{{ t("ui.report.raw_values") }}
      <pre>{% for k, v in r.evidence.items() %}{{ k }}: {{ v }}
{% endfor %}</pre>
    </div>
    {% endif %}
  </div>
  {% endfor %}

  {% if data.source_request %}
  <h2>{{ data.source_request.title }}</h2>
  <p>{{ data.source_request.intro }}</p>
  <blockquote>{{ data.source_request.message }}</blockquote>
  <p class="muted">{{ data.source_request.caution }}</p>
  {% endif %}

  <h2>{{ data.reverse_search.title }}</h2>
  <p>{{ data.reverse_search.intro }}</p>
  <ul>
    {% for service in data.reverse_search.services %}
    <li><a href="{{ service.url }}" rel="noopener noreferrer" target="_blank">{{ service.name }}</a> <span class="print-only">{{ service.url }}</span></li>
    {% endfor %}
  </ul>
  <p class="muted">{{ data.reverse_search.caution }}</p>

  {% if position %}
  <h2>{{ t("ui.report.position") }}</h2>
  <p><code>{{ "%.6f"|format(position.lat) }}, {{ "%.6f"|format(position.lon) }}</code></p>
  <p class="muted">{{ t("ui.report.position_note") }}</p>
  {% endif %}

  {% if previews %}
  <h2>{{ t("ui.report.exploration") }}</h2>
  <p class="muted">{{ t("ui.report.exploration_note") }}</p>
  <div class="previews">
    <figure><img src="{{ previews.image }}" alt="{{ t("ui.report.image") }}"><figcaption>{{ t("ui.report.image") }}</figcaption></figure>
    <figure>
      {% if previews.thumbnail %}
      <img src="{{ previews.thumbnail }}" alt="{{ t("ui.report.preview") }}"><figcaption>{{ t("ui.report.preview") }}</figcaption>
      {% else %}
      <figcaption>{{ t("ui.report.no_preview") }}</figcaption>
      {% endif %}
    </figure>
  </div>
  {% endif %}

  <h2>{{ t("ui.report.file") }}</h2>
  <dl>
    {% if data.file.name %}<dt>{{ t("ui.report.name") }}</dt><dd>{{ data.file.name }}</dd>{% endif %}
    <dt>SHA-256</dt><dd><code>{{ data.file.sha256 }}</code></dd>
    <dt>{{ t("ui.report.size") }}</dt><dd>{{ t("ui.cli.size", size=data.file.size) }}</dd>
    <dt>{{ t("ui.report.format") }}</dt><dd>{{ data.file.real_format or t("ui.report.unknown") }}</dd>
    <dt>{{ t("ui.report.analysed") }}</dt><dd>{{ analysed_at }}</dd>
  </dl>

  <footer>
    <p>{{ t("ui.report.footer", generated=generated_at, talax=data.tools.talax, exiftool=data.tools.exiftool) }}</p>
    <p class="save-pdf">{{ t("ui.report.save_pdf") }}</p>
  </footer>
</main>
</body>
</html>
